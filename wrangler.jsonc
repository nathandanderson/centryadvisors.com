{
  // Static-only Worker: no `main` entry point, so Cloudflare just serves the
  // files in ./public. The dashboard's "Deploy command" (npx wrangler deploy)
  // reads this file; the "Build command" must stay empty, there is no build.
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "centryadvisors",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public",
    // Serves public/404.html for unknown paths instead of a bare 404.
    "not_found_handling": "404-page"
  }
}
