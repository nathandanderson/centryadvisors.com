{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  "trailingSlash": "auto",

  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), camera=(), microphone=(), payment=(), usb=()",
    "Cross-Origin-Opener-Policy": "same-origin"
  },

  "routes": [
    {
      "route": "/",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=86400" }
    }
  ],

  "responseOverrides": {
    "404": {
      "redirect": "/",
      "statusCode": 302
    }
  },

  "mimeTypes": {
    ".ico": "image/x-icon",
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  }
}
